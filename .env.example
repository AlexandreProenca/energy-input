# Lidas pelo servidor — o proxy do Vite (`npm run dev`) e o do contêiner (`docker compose up`).
# Nunca use prefixo VITE_ para credenciais: o Vite embute essas variáveis no bundle público.

# Chave da API de simulação. A interface não pede credencial; ela vem daqui.
SIMULATION_API_TOKEN=

# Só no contêiner: hosts, além de localhost e 127.0.0.1, que recebem a chave, separados por
# espaço. Todo visitante desses hosts simula na conta do dono da chave. Vazio por padrão.
SIMULATION_TOKEN_HOSTS=
